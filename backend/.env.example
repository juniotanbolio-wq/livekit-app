# Copie para .env (ignorado pelo git) e preencha. Nunca commite o .env.

# --- Servidor ---
# Endereço de escuta do servidor HTTP
HTTP_ADDR=:8080
# debug, info, warn ou error
LOG_LEVEL=info
# Caminho do SQLite (no contêiner a imagem já define /data/app.db, em volume)
DATABASE_PATH=data/app.db
# Origens de navegador aceitas (CORS), separadas por vírgula. app://desktop é o app Electron empacotado.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,app://desktop
# Corpo máximo de requisição, em bytes
MAX_BODY_BYTES=32768
# Proxies cujo X-Forwarded-For é confiável (IPs ou CIDRs, separados por vírgula). Vazio = nenhum.
# Na R3, defina com a rede do Caddy; sem isso o rate limit enxerga o IP do proxy e não o do cliente.
TRUSTED_PROXIES=

# --- Sessão ---
# Segredo que assina o JWT de sessão (mínimo 32 caracteres). Gere um aleatório; quem o conhece forja qualquer usuário.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
# Validade da sessão (30m, 6h, 7d...)
JWT_TTL=7d
# Tentativas por IP nas rotas /api/auth/* dentro da janela
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=15m

# --- LiveKit ---
# Mesmo par de chaves do LiveKit (infra/.env: LIVEKIT_API_KEY / LIVEKIT_API_SECRET)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
# Endereço WebSocket do LiveKit que o CLIENTE usa (não o endereço interno do servidor)
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Validade do token de sala
LIVEKIT_TOKEN_TTL=6h
# Endereço HTTP do LiveKit que o BACKEND usa (RoomService, reconciliação). Vazio = deriva de LIVEKIT_PUBLIC_URL
# (ws -> http). No Docker Compose é http://livekit:7880.
LIVEKIT_URL=

# --- Tempo real: presença e menções (docs/protocolo-tempo-real.md) ---
# De quanto em quanto tempo o estado em memória é conferido com o LiveKit (cobre webhooks perdidos)
RECONCILE_INTERVAL=60s
# Prazo para o cliente enviar a mensagem de autenticação depois de abrir o WebSocket
WS_AUTH_TIMEOUT=5s
# Intervalo dos pings do servidor (conexão sem pong em até 10 s é encerrada)
WS_PING_INTERVAL=20s
# Conexões simultâneas por usuário (a mais antiga é encerrada ao exceder) e teto global
WS_MAX_CONNS_PER_USER=3
WS_MAX_CONNS=200
# Menções ("chamar atenção") permitidas por janela, por remetente e por destinatário
MENTION_SENDER_LIMIT=5
MENTION_RECIPIENT_LIMIT=5
MENTION_WINDOW=30s

# --- Convites e seed ---
# Validade padrão de `invite create`, em horas
INVITE_TTL_HOURS=72
# Usados apenas pelo comando `seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=troque-esta-senha
