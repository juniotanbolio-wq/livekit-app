# Copie para .env (ignorado pelo git) e preencha. Nunca commite o .env.

# Segredo da API do LiveKit (32+ caracteres). O nome da chave é fixo (`devkey`) no desenvolvimento.
LIVEKIT_API_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
# IP que o LiveKit anuncia aos clientes para a mídia (127.0.0.1 = cliente na mesma máquina)
LIVEKIT_NODE_IP=127.0.0.1

# Segredo que assina o JWT de sessão do backend (32+ caracteres). Gere um aleatório.
JWT_SECRET=troque-por-outro-segredo-aleatorio-com-32-ou-mais-caracteres
# Usados só por `docker compose exec backend /server seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=troque-esta-senha
# Endereço do LiveKit que o CLIENTE usa (opcional)
# LIVEKIT_PUBLIC_URL=ws://localhost:7880
